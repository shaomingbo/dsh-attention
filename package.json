{
  "name": "dsh-attention",
  "version": "0.1.3",
  "description": "Desktop attention alerts for DeepSeek Harness Web: tab title, favicon, sound, and native OS notifications when an agent needs approval or finishes a turn.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-attention": "bin/install.js"
  },
  "files": [
    "bin/install.js",
    "cordis.patch.yml",
    "lib/index.js",
    "lib/derive.js",
    "lib/native.js",
    "lib/sounds/render.js",
    "lib/sounds/approval.wav",
    "lib/sounds/completed.wav",
    "lib/client.js",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "sounds": "node lib/sounds/build.js",
    "check": "node --check lib/*.js && node --check lib/sounds/*.js && node --check bin/install.js && node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaomingbo/dsh-attention.git"
  },
  "homepage": "https://github.com/shaomingbo/dsh-attention#readme",
  "bugs": {
    "url": "https://github.com/shaomingbo/dsh-attention/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "notifications",
    "attention",
    "web-gui"
  ],
  "author": "shaomingbo",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  }
}
